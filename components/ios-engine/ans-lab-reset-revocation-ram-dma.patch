+/* Check EVERY data segment before any backend operation or guest data copy.
+ * Only ordinary guest RAM is accepted in this experimental path; CMB/PMR,
+ * MMIO, RAM devices and ROM have no validated protected-DMA contract here.
+ * address_space_access_valid alone does not enforce attrs.memory.
+ */
+static bool nvme_apple_ans_lab_preflight(NvmeRequest *req, size_t bytes,
+                                        bool guest_write)
+{
+    NvmeSg *sg = &req->sg;
+    MemTxAttrs attrs = MEMTXATTRS_UNSPECIFIED;
+    attrs.memory = true;
+    if (!(sg->flags & NVME_SG_ALLOC) || !(sg->flags & NVME_SG_DMA) ||
+        !bytes || bytes > 1024 * 1024 || sg->qsg.size != bytes ||
+        sg->qsg.nsg < 1 || sg->qsg.nsg > 257) {
+        return false;
+    }
+    RCU_READ_LOCK_GUARD();
+    for (int index = 0; index < sg->qsg.nsg; index++) {
+        hwaddr address = sg->qsg.sg[index].base;
+        hwaddr left = sg->qsg.sg[index].len;
+        if (!left || left - 1 > UINT64_MAX - address) {
+            return false;
+        }
+        while (left) {
+            hwaddr translated, length = left;
+            MemoryRegion *mr = address_space_translate(sg->qsg.as, address,
+                &translated, &length, guest_write, attrs);
+            if (!length || length > left || !memory_region_is_ram(mr) ||
+                memory_region_is_ram_device(mr) || memory_region_is_rom(mr) ||
+                !memory_access_is_direct(mr, guest_write, attrs)) {
+                return false;
+            }
+            left -= length;
+            if (left) {
+                if (length > UINT64_MAX - address) {
+                    return false;
+                }
+                address += length;
+            }
+        }
+    }
+    return true;
+}
+
+static int nvme_apple_ans_lab_tx(NvmeRequest *req, uint8_t *data, size_t bytes,
+                                 bool guest_write)
+{
+    MemTxAttrs attrs = MEMTXATTRS_UNSPECIFIED;
+    dma_addr_t residual = bytes;
+    MemTxResult result;
+    attrs.memory = true;
+    if (!nvme_apple_ans_lab_current(req) ||
+        !nvme_apple_ans_lab_preflight(req, bytes, guest_write)) {
+        return -EFAULT;
+    }
+    result = guest_write ? dma_buf_read(data, bytes, &residual, &req->sg.qsg, attrs)
+                         : dma_buf_write(data, bytes, &residual, &req->sg.qsg, attrs);
+    return result == MEMTX_OK && !residual ? 0 : -EFAULT;
+}
