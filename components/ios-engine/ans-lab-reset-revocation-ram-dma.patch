+/* SQ BHs use qemu_bh_new_guarded (main AioContext), and blk_aio_* completes
+ * in its submitting AioContext. Reset and these existing NVMe paths are owned
+ * by the main loop/BQL; no context mutex may be held across guest DMA/MMIO.
+ * A future IOThread or SEP-thread provider needs an explicit handoff protocol.
+ */
+static bool nvme_apple_ans_lab_current(NvmeRequest *req)
+{
+    NvmeCtrl *n = nvme_ctrl(req);
+    return req->apple_ans_lab_key_valid && !n->apple_ans_lab_quiescing &&
+           !n->apple_ans_lab_epoch_exhausted &&
+           req->apple_ans_lab_generation == n->apple_ans_lab_generation &&
+           (req->cmd.flags != 0x04 || !n->apple_ans_lab_wrapped_revoked);
 }
 
