+/* Experimental standard-XTS path for PUBLIC/SYNTHETIC raw keys only.
+ * K1=first16, K2=second16 and LE64 IV are standard conventions; the Apple
+ * hardware ABI is NOT validated. Wrapped requests remain unsupported. */
+typedef struct NvmeAppleANSLabIO {
+    NvmeRequest *req;
+    BlockCompletionFunc *complete;
+    QEMUIOVector iov;
+    uint8_t *bounce;
+    size_t bytes;
+    bool write;
+} NvmeAppleANSLabIO;
+
+static int nvme_apple_ans_lab_transform(NvmeRequest *req, uint8_t *data,
+                                       size_t bytes, bool encrypt)
+{
+    uint64_t unit = ldq_le_p((uint8_t *)&req->cmd + 0x38);
+    QCryptoCipher *cipher;
+    Error *error = NULL;
+    int ret = 0;
+    cipher = qcrypto_cipher_new(QCRYPTO_CIPHER_ALGO_AES_128,
+                               QCRYPTO_CIPHER_MODE_XTS,
+                               req->apple_ans_lab_key, 32, &error);
+    if (!cipher) {
+        error_free(error);
+        return -EIO;
+    }
+    for (size_t offset = 0; offset < bytes; offset += 4096, unit++) {
+        uint8_t iv[16] = { 0 };
+        stq_le_p(iv, unit);
+        if (qcrypto_cipher_setiv(cipher, iv, sizeof(iv), &error) < 0 ||
+            (encrypt ? qcrypto_cipher_encrypt(cipher, data + offset,
+                         data + offset, 4096, &error)
+                     : qcrypto_cipher_decrypt(cipher, data + offset,
+                         data + offset, 4096, &error)) < 0) {
+            ret = -EIO;
+            break;
+        }
+    }
+    /* qcrypto's provider currently frees expanded contexts without a proven
+     * explicit wipe. This lab-only path does not claim that issue solved. */
+    qcrypto_cipher_free(cipher);
+    error_free(error);
+    return ret;
+}
+
+static void nvme_apple_ans_lab_io_done(void *opaque, int ret)
+{
+    NvmeAppleANSLabIO *io = opaque;
+    NvmeRequest *req = io->req;
+    BlockCompletionFunc *complete = io->complete;
+    if (!ret && req->status != NVME_SUCCESS) {
+        ret = -ECANCELED;
+    }
+    if (!ret && !io->write) {
+        ret = nvme_apple_ans_lab_transform(req, io->bounce, io->bytes, false);
+        if (!ret && nvme_tx(nvme_ctrl(req), &req->sg, io->bounce, io->bytes,
+                           NVME_TX_DIRECTION_FROM_DEVICE)) {
+            ret = -EFAULT;
+        }
+    }
+    nvme_apple_ans_lab_clear_key(req);
+    nvme_apple_ans_lab_wipe(io->bounce, io->bytes);
+    g_free(io->bounce);
+    qemu_iovec_destroy(&io->iov);
+    g_free(io);
+    req->aiocb = NULL;
+    complete(req, ret);
+}
+
+static void nvme_apple_ans_lab_start(BlockBackend *blk, int64_t offset,
+                                     BlockCompletionFunc *complete,
+                                     NvmeRequest *req, bool write)
+{
+    NvmeRwCmd *rw = (NvmeRwCmd *)&req->cmd;
+    size_t bytes = ((size_t)le16_to_cpu(rw->nlb) + 1) * 4096;
+    NvmeAppleANSLabIO *io = g_new0(NvmeAppleANSLabIO, 1);
+    io->req = req;
+    io->bytes = bytes;
+    io->write = write;
+    io->complete = complete;
+    io->bounce = g_malloc0(bytes);
+    qemu_iovec_init(&io->iov, 1);
+    qemu_iovec_add(&io->iov, io->bounce, bytes);
+    if (write) {
+        if (nvme_tx(nvme_ctrl(req), &req->sg, io->bounce, bytes,
+                    NVME_TX_DIRECTION_TO_DEVICE)) {
+            nvme_apple_ans_lab_io_done(io, -EFAULT);
+            return;
+        }
+        if (nvme_apple_ans_lab_transform(req, io->bounce, bytes, true)) {
+            nvme_apple_ans_lab_io_done(io, -EIO);
+            return;
+        }
+        req->aiocb = blk_aio_pwritev(blk, offset, &io->iov, 0,
+                                     nvme_apple_ans_lab_io_done, io);
+    } else {
+        req->aiocb = blk_aio_preadv(blk, offset, &io->iov, 0,
+                                    nvme_apple_ans_lab_io_done, io);
+    }
+}
