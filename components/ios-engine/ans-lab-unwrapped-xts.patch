+/* These bytes must never enter tracing, errors, migration or snapshots. */
+static void nvme_apple_ans_lab_wipe(void *buffer, size_t bytes)
+{
+    volatile uint8_t *p = buffer;
+    while (bytes--) {
+        *p++ = 0;
+    }
+}
+
+static void nvme_apple_ans_lab_clear_key(NvmeRequest *req)
+{
+    nvme_apple_ans_lab_wipe(req->apple_ans_lab_key,
+                          sizeof(req->apple_ans_lab_key));
+    req->apple_ans_lab_key_valid = false;
+}
