+/* AUTHORIZED TESTING ONLY: explicit public/synthetic context provider.
+ * No t8030 machine sets these properties. This is NOT a guest SEP key bridge.
+ * The secret object contains Kwrap32 || Kauth32; never trace its identifier,
+ * value, decoded frame, authentication result detail or unwrapped key. */
+static bool nvme_apple_ans_lab_unwrap(NvmeCtrl *n,
+                                      const uint8_t extension[64],
+                                      uint8_t raw_key[32])
+{
+    uint8_t *context = NULL;
+    size_t context_bytes = 0;
+    Error *error = NULL;
+    bool valid = false;
+
+    if (!n->params.apple_ans_lab_wrapped_xts ||
+        !n->params.apple_ans_lab_wrapped_xts_secret) {
+        return false;
+    }
+    if (qcrypto_secret_lookup(n->params.apple_ans_lab_wrapped_xts_secret,
+                             &context, &context_bytes, &error) < 0 ||
+        context_bytes != 64) {
+        goto cleanup;
+    }
+    /* The codec leaves raw_key untouched on every failure and checks the MAC
+     * in constant work before decrypting. The flags and reserved prefix are
+     * exact; context authentication does not independently bind Kwrap. */
+    valid = huntmob_wrapped_reference_unwrap(context, context + 32,
+                                             extension, 64, raw_key,
+                                             &error) == 0;
+cleanup:
+    if (context) {
+        nvme_apple_ans_lab_wipe(context, context_bytes);
+        g_free(context);
+    }
+    error_free(error);
+    return valid;
+}
