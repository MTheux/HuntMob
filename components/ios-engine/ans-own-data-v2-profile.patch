+static char *t8030_get_virtual_data_profile(Object *obj, Error **errp)
+{
+    return g_strdup(APPLE_T8030(obj)->virtual_data_v2 ? "v2" : "v1");
+}
+
+static void t8030_set_virtual_data_profile(Object *obj, const char *value,
+                                          Error **errp)
+{
+    AppleT8030MachineState *s = APPLE_T8030(obj);
+    if (s->virtual_sep) {
+        error_setg(errp, "Own DATA profile is immutable after initialization");
+        return;
+    }
+    if (!value || (strcmp(value, "v1") && strcmp(value, "v2"))) {
+        error_setg(errp, "Only own DATA profiles v1 and v2 are supported");
+        return;
+    }
+    s->virtual_data_v2 = !strcmp(value, "v2");
+}
