+/* Only coarse operation classes, never key or slot selectors. */
+static const char *aess_diagnostic_operation(uint32_t operation)
+{
+    switch (operation) {
+    case 0x00:
+    case 0x10:
+        return "seed-sync";
+    case 0x01:
+        return "key-setup";
+    case 0x02:
+    case 0x12:
+        return "uid-wrap";
+    case SEP_AESS_COMMAND_ENCRYPT_CBC_ONLY_NONCUSTOM_FORCE_CUSTOM_AES256:
+    case SEP_AESS_COMMAND_ENCRYPT_CBC_FORCE_CUSTOM_AES256:
+    case SEP_AESS_COMMAND_ENCRYPT_CBC:
+        return "cbc-encrypt";
+    case SEP_AESS_COMMAND_DECRYPT_CBC:
+        return "cbc-decrypt";
+    case SEP_AESS_COMMAND_0xB:
+        return "key-load";
+    default:
+        return "other";
+    }
+}
