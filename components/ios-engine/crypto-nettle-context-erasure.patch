+/* Wipe the complete concrete allocation, including schedules and IV, before
+ * returning it to the allocator. Volatile stores must survive optimization. */
+static void qcrypto_nettle_ctx_wipe(void *buffer, size_t bytes)
+{
+    volatile uint8_t *p = buffer;
+    while (bytes--) {
+        *p++ = 0;
+    }
+}
+
+#define DEFINE_FREE(NAME, TYPE)                                      \
+static void NAME##_free(QCryptoCipher *cipher)                        \
+{                                                                    \
+    TYPE *ctx = container_of(cipher, TYPE, base);                     \
+    qcrypto_nettle_ctx_wipe(ctx, sizeof(*ctx));                        \
+    g_free(ctx);                                                     \
 }
 
