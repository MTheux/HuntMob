+/* Only the observed v1 ROM control ABI is accepted in this opt-in path.
+ * Values traced here are public selectors, bounds and control bits, never
+ * AESS input, key bytes, ciphertext or authentication tags. */
+static bool sep_virtual_mpe_write(AppleSEPState *s, hwaddr addr,
+                                   uint64_t value, unsigned size)
+{
+    HuntMobVirtualMPEMemory *memory = s->virtual_mpe_memory;
+    HuntMobVirtualMPE *core = NULL;
+    AppleSEPVirtualMPEInit *init;
+    Error *local_err = NULL;
+    uint64_t length;
+    uint32_t data = value;
+    unsigned region, offset;
+    bool ok = false;
+
+    assert(bql_locked());
+    s->virtual_mpe_started = true;
+    if (size != 4 || value > UINT32_MAX || s->virtual_mpe_faulted ||
+        !memory || !huntmob_virtual_mpe_memory_consumer_ready(memory)) {
+        goto done;
+    }
+    core = huntmob_virtual_mpe_memory_core(memory);
+    if (!core) {
+        goto done;
+    }
+    switch (addr) {
+    case 0x80:
+        if (data != 0 && data != 0x100) {
+            break;
+        }
+        ok = huntmob_virtual_mpe_latch_key(core, data == 0x100);
+        break;
+    case 0x300:
+        if (s->virtual_mpe_configured &&
+            data != s->virtual_mpe_primary_base_kib) {
+            break;
+        }
+        s->virtual_mpe_primary_base_kib = data;
+        s->virtual_mpe_primary_base_written = true;
+        ok = true;
+        break;
+    case 0x318:
+        if (s->virtual_mpe_configured &&
+            (!s->virtual_mpe_secondary_base_written ||
+             data != s->virtual_mpe_secondary_base_kib)) {
+            break;
+        }
+        s->virtual_mpe_secondary_base_kib = data;
+        s->virtual_mpe_secondary_base_written = true;
+        ok = true;
+        break;
+    case 0x310:
+        if (s->virtual_mpe_configured) {
+            ok = data == s->virtual_mpe_primary_length_kib;
+            break;
+        }
+        if (!huntmob_virtual_mpe_both_latched(core) ||
+            (data && !s->virtual_mpe_primary_base_written)) {
+            break;
+        }
+        ok = huntmob_virtual_mpe_memory_configure(
+            memory, (uint64_t)s->virtual_mpe_primary_base_kib << 10,
+            (uint64_t)data << 10,
+            (uint64_t)s->virtual_mpe_secondary_base_kib << 10,
+            s->virtual_mpe_secondary_base_written, &local_err);
+        if (ok) {
+            s->virtual_mpe_primary_length_kib = data;
+            s->virtual_mpe_configured = true;
+        }
+        break;
+    case 0x200:
+    case 0x204:
+        /* Fresh initialization clears the memory-integrity replay words.
+         * Nonzero restore state has no proven v1 consumer contract yet. */
+        ok = s->virtual_mpe_configured && data == 0;
+        break;
+    case 0x400: case 0x408: case 0x410: case 0x414:
+    case 0x420: case 0x428: case 0x430: case 0x434:
+        region = addr >= 0x420;
+        offset = addr - (region ? 0x420 : 0x400);
+        init = &s->virtual_mpe_init[region];
+        length = huntmob_virtual_mpe_memory_region_length(memory, region);
+        if (!s->virtual_mpe_configured || !length || length % 512) {
+            break;
+        }
+        if (offset == 0 || offset == 8) {
+            if (init->control & 1) {
+                break;
+            }
+            if (offset == 0) {
+                if (data != 0) {
+                    break;
+                }
+                init->first_sector = data;
+            } else {
+                if (data != 0 && data != (length >> 9) - 1) {
+                    break;
+                }
+                init->last_sector = data;
+            }
+            ok = true;
+        } else if (offset == 0x10) {
+            if (data & ~1U) {
+                break;
+            }
+            if (data & 1) {
+                if (init->first_sector ||
+                    init->last_sector != (length >> 9) - 1) {
+                    break;
+                }
+                init->started = true;
+                init->pending_finish = false;
+                init->finished = false;
+            } else if (init->control & 1) {
+                init->pending_finish = true;
+            }
+            init->control = data;
+            ok = true;
+        } else if (offset == 0x14 && data == 1) {
+            if (init->finished && !init->control &&
+                huntmob_virtual_mpe_is_active(core, region)) {
+                ok = true;
+            } else if (init->started && init->pending_finish &&
+                       !init->control && !init->first_sector &&
+                       !init->last_sector) {
+                ok = huntmob_virtual_mpe_memory_initialize_region(
+                    memory, region, &local_err);
+                if (ok) {
+                    init->pending_finish = false;
+                    init->finished = true;
+                }
+            }
+        }
+        break;
+    default:
+        /* No new success-only emulation of unknown MPE control registers. */
+        break;
+    }
+    if (ok) {
+        stl_le_p(&s->misc1_regs[addr], data);
+    }
+done:
+    error_free(local_err);
+    trace_apple_sep_virtual_mpe_control("control", addr,
+        (addr == 0x80 || addr == 0x300 || addr == 0x310 || addr == 0x318 ||
+         addr == 0x400 || addr == 0x408 || addr == 0x410 || addr == 0x414 ||
+         addr == 0x420 || addr == 0x428 || addr == 0x430 || addr == 0x434) &&
+        size == 4 && value <= UINT32_MAX ? value : 0, ok);
+    if (!ok) {
+        sep_virtual_mpe_fault(s, addr);
+    }
+    return ok;
+}
+
+static void sep_virtual_mpe_bridge_reset(AppleSEPState *s)
+{
+    assert(bql_locked());
+    /* The initial device reset occurs after construction, before ROM loading.
+     * A later full reset renews the consumer's core and private boot salt. */
+    if (s->virtual_mpe_started && s->virtual_mpe_memory) {
+        huntmob_virtual_mpe_memory_reset(s->virtual_mpe_memory);
+    }
+    s->virtual_mpe_primary_base_kib = 0;
+    s->virtual_mpe_primary_length_kib = 0;
+    s->virtual_mpe_secondary_base_kib = 0;
+    s->virtual_mpe_primary_base_written = false;
+    s->virtual_mpe_secondary_base_written = false;
+    s->virtual_mpe_configured = false;
+    s->virtual_mpe_started = false;
+    s->virtual_mpe_faulted = false;
+    memset(s->virtual_mpe_init, 0, sizeof(s->virtual_mpe_init));
+    trace_apple_sep_virtual_mpe_control("reset", 0, 0, true);
+}
+
 static void misc1_reg_write(void *opaque, hwaddr addr, uint64_t data,
                             unsigned size)
 {
     AppleSEPState *s = opaque;
+
+    if (s->virtual_sep && s->virtual_mpe_memory) {
+        sep_virtual_mpe_write(s, addr, data, size);
+        return;
+    }
 
 #ifdef ENABLE_CPU_DUMP_STATE
     cpu_dump_state(CPU(s->cpu), stderr, CPU_DUMP_CODE);
@@ -3927,7 +4158,9 @@
     default:
     jump_default:
         memcpy(&ret, &s->misc1_regs[addr], size);
-        DPRINTF("SEP MISC1: Unknown read at 0x" HWADDR_FMT_plx "\n", addr);
+        if (!s->virtual_sep) {
+            DPRINTF("SEP MISC1: Unknown read at 0x" HWADDR_FMT_plx "\n", addr);
+        }
         break;
     }
 
@@ -4905,6 +5138,9 @@
     memset(s->debug_trace_regs, 0, sizeof(s->debug_trace_regs));
 #endif
 
+    if (s->virtual_mpe_memory) {
+        sep_virtual_mpe_bridge_reset(s);
+    }
     aess_reset(&s->aess_state);
     aesh_reset(&s->aesh_state);
     pka_reset(&s->pka_state);
