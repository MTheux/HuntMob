 /* This entire path is opt-in. No virtual private operation falls through to
  * globally known UID constants, the XOR approximation or legacy key dumps. */
+/* Own VirtualMPE-v1 bridge, not Apple's memory cipher or attestation.
+ * The memory module owns the real ROMD/ciphertext consumer. No ACK is issued
+ * for a key load unless that consumer and its private caches exist. */
+static void sep_virtual_mpe_fault(AppleSEPState *s, hwaddr reg)
+{
+    assert(bql_locked());
+    if (!s->virtual_mpe_faulted && s->virtual_mpe_memory) {
+        huntmob_virtual_mpe_memory_reset(s->virtual_mpe_memory);
+    }
+    s->virtual_mpe_faulted = true;
+    s->virtual_mpe_configured = false;
+    trace_apple_sep_virtual_mpe_control("revoked", reg, 0, false);
+}
+
+static bool sep_virtual_mpe_stage(AppleSEPState *s, unsigned slot,
+                                   const uint8_t input[32])
+{
+    HuntMobVirtualMPE *core;
+    bool ok = false;
+
+    assert(bql_locked());
+    s->virtual_mpe_started = true;
+    if (!s->virtual_mpe_faulted && s->virtual_mpe_memory &&
+        huntmob_virtual_mpe_memory_consumer_ready(s->virtual_mpe_memory)) {
+        core = huntmob_virtual_mpe_memory_core(s->virtual_mpe_memory);
+        ok = core && huntmob_virtual_mpe_regions_bound(core) &&
+             huntmob_virtual_mpe_stage_key(core, slot, input);
+    }
+    trace_apple_sep_virtual_mpe_control("stage", 8,
+                                        slot ? 0x251 : 0x211, ok);
+    if (!ok) {
+        sep_virtual_mpe_fault(s, 8);
+    }
+    return ok;
+}
+
+void apple_sep_set_virtual_mpe(AppleSEPState *s,
+                                HuntMobVirtualMPEMemory *memory)
+{
+    assert(!qdev_is_realized(DEVICE(s)) && s->virtual_sep && memory &&
+           !s->virtual_mpe_memory);
+    s->virtual_mpe_memory = memory;
+}
