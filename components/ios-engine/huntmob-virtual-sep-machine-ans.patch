+
+static void t8030_virtual_finalize(Object *obj)
+{
+    AppleT8030MachineState *s = APPLE_T8030(obj);
+    /* Machine children and their users must be stopped before machine teardown. */
+    if (s->virtual_sep_migration_blocker) {
+        migrate_del_blocker(&s->virtual_sep_migration_blocker);
+    }
+    huntmob_virtual_sep_free(s->virtual_sep);
+    g_free(s->virtual_sep_root_secret);
+    g_free(s->virtual_sep_vm_id);
+}
