+}
+
+static char *t8030_get_virtual_id(Object *obj, Error **errp)
+{
+    return g_strdup(APPLE_T8030(obj)->virtual_sep_vm_id);
+}
+
+static void t8030_set_virtual_id(Object *obj, const char *value, Error **errp)
+{
+    AppleT8030MachineState *s = APPLE_T8030(obj);
+    if (s->virtual_sep) {
+        error_setg(errp, "Virtual SEP identity is immutable after initialization");
+        return;
+    }
+    g_free(s->virtual_sep_vm_id);
+    s->virtual_sep_vm_id = g_strdup(value);
