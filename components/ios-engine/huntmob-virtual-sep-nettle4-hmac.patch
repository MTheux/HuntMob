 typedef void (*qcrypto_nettle_hmac_setkey)(void *ctx,
                                            size_t key_length,
@@ -44,6 +45,34 @@
     } u;
 };
 
+/* Nettle 4 removed the length argument from fixed-size HMAC digest APIs.
+ * A function-pointer cast cannot adapt this ABI: it passes length as a pointer.
+ * Keep a correctly typed adapter for both supported API families instead. */
+#if NETTLE_VERSION_MAJOR >= 4
+#define CALL_HMAC_DIGEST(name, ctx, length, output) name(ctx, output)
+#else
+#define CALL_HMAC_DIGEST(name, ctx, length, output) name(ctx, length, output)
+#endif
+#define DEFINE_HMAC_DIGEST_ADAPTER(name, bytes)                         \
+static void qcrypto_compat_##name(void *ctx, size_t length, uint8_t *output) \
+{                                                                      \
+    g_assert(length == (bytes));                                       \
+    (void)length;                                                      \
+    CALL_HMAC_DIGEST(name, ctx, length, output);                        \
+}
+DEFINE_HMAC_DIGEST_ADAPTER(hmac_md5_digest, MD5_DIGEST_SIZE)
+DEFINE_HMAC_DIGEST_ADAPTER(hmac_sha1_digest, SHA1_DIGEST_SIZE)
+DEFINE_HMAC_DIGEST_ADAPTER(hmac_sha224_digest, SHA224_DIGEST_SIZE)
+DEFINE_HMAC_DIGEST_ADAPTER(hmac_sha256_digest, SHA256_DIGEST_SIZE)
+DEFINE_HMAC_DIGEST_ADAPTER(hmac_sha384_digest, SHA384_DIGEST_SIZE)
+DEFINE_HMAC_DIGEST_ADAPTER(hmac_sha512_digest, SHA512_DIGEST_SIZE)
+DEFINE_HMAC_DIGEST_ADAPTER(hmac_ripemd160_digest, RIPEMD160_DIGEST_SIZE)
+#ifdef CONFIG_CRYPTO_SM3
+DEFINE_HMAC_DIGEST_ADAPTER(hmac_sm3_digest, SM3_DIGEST_SIZE)
+#endif
+#undef DEFINE_HMAC_DIGEST_ADAPTER
+#undef CALL_HMAC_DIGEST
+
 struct qcrypto_nettle_hmac_alg {
     qcrypto_nettle_hmac_setkey setkey;
     qcrypto_nettle_hmac_update update;
@@ -53,50 +82,50 @@
