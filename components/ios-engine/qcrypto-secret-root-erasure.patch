+/* Secret bytes can include embedded NULs; erase by recorded byte count. */
+static void qcrypto_secret_erase(void *buffer, size_t length)
+{
+    volatile uint8_t *bytes = buffer;
+    if (bytes) {
+        while (length--) {
+            *bytes++ = 0;
+        }
+    }
+}
 
