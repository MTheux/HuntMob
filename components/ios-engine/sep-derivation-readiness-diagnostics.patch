+/* Exact MMIO words from the pinned AESSEP initializer, not service IDs.
+ * Program requests currently copy input registers with an upstream placeholder;
+ * commands 4/5 have no implementation. Neither proves a derived context valid.
+ * Never emit key bytes, register words, bank selectors or input provenance. */
+static void aess_trace_derivation_readiness(uint32_t cmd)
+{
+    switch (cmd) {
+    case 0x201:
+    case 0x241:
+        trace_apple_sep_derivation_readiness("program-request", "wrapping",
+                                             false);
+        break;
+    case 0x281:
+    case 0x2c1:
+        trace_apple_sep_derivation_readiness("program-request", "authentication",
+                                             false);
+        break;
+    case 0x205:
+    case 0x245:
+        trace_apple_sep_derivation_readiness("unsupported-derive", "wrapping",
+                                             false);
+        break;
+    case 0x204:
+    case 0x244:
+        trace_apple_sep_derivation_readiness("unsupported-derive",
+                                             "authentication", false);
+        break;
+    default:
+        break;
+    }
+}
+
 static void aess_handle_cmd(AppleAESSState *s)
 {
