+/* Experimental own virtual identity, never an Apple hardware KDF claim. */
+void apple_sep_set_virtual_provider(AppleSEPState *s,
+                                    HuntMobVirtualSEP *provider)
+{
+    assert(!qdev_is_realized(DEVICE(s)) && !s->virtual_sep && provider);
