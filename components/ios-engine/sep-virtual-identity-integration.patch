+/* This entire path is opt-in. No virtual private operation falls through to
+ * globally known UID constants, the XOR approximation or legacy key dumps. */
+static bool aess_virtual_command(AppleAESSState *s)
+{
+    HuntMobVirtualSEP *p = s->sep->virtual_sep;
+    uint32_t cmd = s->command;
+    uint32_t op = SEP_AESS_CMD_WITHOUT_FLAGS(cmd);
+    bool custom = cmd & SEP_AESS_CMD_FLAG_KEYSELECT_CUSTOM;
+    bool gid1 = cmd & SEP_AESS_CMD_FLAG_KEYSELECT_GID1;
+    Error *local_err = NULL;
+    QCryptoCipher *cipher = NULL;
+    uint8_t iv[16] = { 0 }, output[32] = { 0 };
+    bool ok = false;
+    unsigned slot;
+
+    sep_virtual_erase(s->out_full, sizeof(s->out_full));
+    if ((cmd & 0x300) == 0x300 ||
+        check_register_0x18_KEYDISABLE_BIT_INVALID(cmd, s->reg_0x18_keydisable)) {
+        goto out;
+    }
+    switch (cmd) {
+    case 0x201: slot = 0; goto program;
+    case 0x241: slot = 1; goto program;
+    case 0x281: slot = 2; goto program;
+    case 0x2c1: slot = 3; goto program;
+program:
+        ok = huntmob_virtual_sep_program(p, slot, s->in_full, &local_err);
+        break;
+    case 0x205: case 0x245: case 0x204: case 0x244:
+        ok = huntmob_virtual_sep_derive(p, cmd, &local_err);
+        break;
+    default:
+        if (op == 0 || op == 0x10) {
+            /* Preserve the model's seed-sync conditions, without copying any
+             * public UID into the virtual private key state. */
+            if (gid1) {
+                if (op == 0) {
+                    s->keywrap_uid0_enabled = true;
+                } else {
+                    s->keywrap_uid1_enabled = true;
+                }
+            }
+            ok = true;
+        } else if (!gid1 && !custom && op == SEP_AESS_COMMAND_0xB) {
+            sep_virtual_erase(s->key_256_in, sizeof(s->key_256_in));
+            memcpy(s->key_256_in, s->in_full, sizeof(s->key_256_in));
+            s->virtual_custom_key_loaded = true;
+            ok = true;
+        } else if (!gid1 && !custom && (op == 2 || op == 0x12)) {
+            bool seeded = op == 2 ? s->keywrap_uid0_enabled : s->keywrap_uid1_enabled;
+            /* Own v1 policy: prior sync is mandatory; UID1 bit3 denies use.
+             * GID-domain bits0/1/4 do not disable UID as a side effect. */
+            if (seeded && !(s->reg_0x18_keydisable & ~0x1bU) &&
+                (op == 2 || !(s->reg_0x18_keydisable & 8))) {
+                ok = huntmob_virtual_sep_uid_transform(
+                    p, op == 2 ? 0 : 1, s->seed_bits,
+                    s->reg_0x14_keywrap_iterations_counter,
+                    s->in_full, output, &local_err);
+            }
+            s->reg_0x14_keywrap_iterations_counter = 0;
+            if (ok) {
+                memcpy(s->out_full, output, sizeof(output));
+            }
+        } else if (op == SEP_AESS_COMMAND_ENCRYPT_CBC_ONLY_NONCUSTOM_FORCE_CUSTOM_AES256 ||
+                   op == SEP_AESS_COMMAND_ENCRYPT_CBC_FORCE_CUSTOM_AES256) {
+            if (op == SEP_AESS_COMMAND_ENCRYPT_CBC_ONLY_NONCUSTOM_FORCE_CUSTOM_AES256 && custom) {
+                goto out;
+            }
+            slot = op == SEP_AESS_COMMAND_ENCRYPT_CBC_ONLY_NONCUSTOM_FORCE_CUSTOM_AES256 ?
+                   (gid1 ? 1 : 0) : (gid1 ? 3 : 2);
+            if (!custom) {
+                ok = huntmob_virtual_sep_slot_crypt(
+                    p, slot, true, iv, s->in_full, output, 32, &local_err);
+                if (ok) {
+                    memcpy(s->out_full, output, 32);
+                }
+            } else {
+                memcpy(iv, s->iv, sizeof(iv));
+                ok = huntmob_virtual_sep_slot_crypt(
+                    p, slot, true, iv, s->in, output, 16, &local_err);
+                if (ok) {
+                    memcpy(s->tag_out, iv, 16);
+                    memcpy(s->out, output, 16);
+                }
+            }
+        } else if (op == SEP_AESS_COMMAND_ENCRYPT_CBC ||
+                   op == SEP_AESS_COMMAND_DECRYPT_CBC) {
+            /* Explicit caller keys (POST) and shared legacy GID keys remain
+             * separate from the private UID/inline domains. No UID fallback. */
+            const uint8_t *key = custom ? s->key_256_in :
+                                 (const uint8_t *)(gid1 ? AESS_GID1 : AESS_GID0);
+            QCryptoCipherAlgo alg = get_aes_cipher_alg(cmd);
+            bool encrypt = op == SEP_AESS_COMMAND_ENCRYPT_CBC;
+            if (custom && !s->virtual_custom_key_loaded) {
+                goto out;
+            }
+            cipher = qcrypto_cipher_new(alg, QCRYPTO_CIPHER_MODE_CBC, key,
+                                         qcrypto_cipher_get_key_len(alg), &local_err);
+            if (!cipher) {
+                goto out;
+            }
+            memcpy(iv, encrypt ? s->iv : s->iv_dec, 16);
+            ok = qcrypto_cipher_setiv(cipher, iv, 16, &local_err) == 0;
+            if (ok && encrypt) {
+                ok = qcrypto_cipher_encrypt(cipher, s->in, output, 16, &local_err) == 0;
+            } else if (ok) {
+                ok = qcrypto_cipher_decrypt(cipher, s->in_dec, output, 16, &local_err) == 0;
+            }
+            if (ok) {
+                memcpy(s->out, output, 16);
+                if (encrypt) {
+                    memcpy(s->tag_out, iv, 16);
+                } else {
+                    /* Legacy register layout also exposes the ECB intermediate. */
+                    memset(iv, 0, sizeof(iv));
+                    ok = qcrypto_cipher_setiv(cipher, iv, 16, &local_err) == 0 &&
+                         qcrypto_cipher_decrypt(cipher, s->in_dec, output, 16, &local_err) == 0;
+                    if (ok) {
+                        memcpy(s->tag_out, output, 16);
+                    }
+                }
+            }
+        }
+    }
+out:
+    if (cipher) {
+        qcrypto_cipher_free(cipher);
+    }
+    error_free(local_err);
+    sep_virtual_erase(iv, sizeof(iv));
+    sep_virtual_erase(output, sizeof(output));
+    if (!ok) {
+        huntmob_virtual_sep_revoke(p);
+        sep_virtual_erase(s->out_full, sizeof(s->out_full));
+        sep_virtual_erase(s->in_full, sizeof(s->in_full));
+    }
+    trace_apple_sep_derivation_readiness(
+        ok ? "virtual-operation" : "virtual-operation-rejected", "provider",
+        ok && huntmob_virtual_sep_is_ready(p));
+    return ok;
+}
